<div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Enlarged photograph">
  <button type="button" id="lbClose">Close</button>
  <button type="button" id="lbPrev" aria-label="Previous photograph">&larr;</button>
  <button type="button" id="lbNext" aria-label="Next photograph">&rarr;</button>
